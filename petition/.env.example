# Copy to .env and fill in. Never commit .env.

# Where signature and member notifications are sent.
ORGANIZER_EMAIL=dezzerea70@gmail.com

# Gmail sending. Create an App Password at https://myaccount.google.com/apppasswords
# (requires 2-Step Verification on the Google account). Use the 16-character password here.
GMAIL_USER=dezzerea70@gmail.com
GMAIL_APP_PASSWORD=

# Or any SMTP provider instead of Gmail (leave GMAIL_* blank if you use these):
# MAIL_TRANSPORT=smtp
# SMTP_HOST=
# SMTP_PORT=587
# SMTP_SECURE=false
# SMTP_USER=
# SMTP_PASS=
# SMTP_FROM=

# Admin page login (HTTP basic auth). Pick a long password.
ADMIN_USER=organizer
ADMIN_PASSWORD=

# Public address of the site, used in emails (no trailing slash).
PUBLIC_URL=https://example.org

# Signature goal shown on the page.
SIGNATURE_GOAL=1000

# Where the SQLite database lives. Mount a persistent volume here in production.
DATA_DIR=./data

PORT=3000
