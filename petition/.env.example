# Copy to .env and fill in. Never commit .env.

# Every signature and coalition sign-up is emailed to dezzerea70@gmail.com automatically.
# That address is fixed in lib/mailer.js. To copy additional people, list them here:
# NOTIFY_ALSO=second@example.com,third@example.com

# Gmail sending. Create an App Password at https://myaccount.google.com/apppasswords
# (requires 2-Step Verification on the Google account). Use the 16-character password here.
GMAIL_USER=dezzerea70@gmail.com
GMAIL_APP_PASSWORD=

# Or any SMTP provider instead of Gmail (leave GMAIL_* blank if you use these):
# MAIL_TRANSPORT=smtp
# SMTP_HOST=
# SMTP_PORT=587
# SMTP_SECURE=false
# SMTP_USER=
# SMTP_PASS=
# SMTP_FROM=

# Admin page login (HTTP basic auth). Pick a long password.
ADMIN_USER=organizer
ADMIN_PASSWORD=

# Public address of the site, used in emails (no trailing slash).
PUBLIC_URL=https://example.org

# Signature goal shown on the page.
SIGNATURE_GOAL=1000

# Where the SQLite database lives. Mount a persistent volume here in production.
DATA_DIR=./data

PORT=3000

# In production the server refuses to start without mail credentials.
NODE_ENV=production

# District lookup via the U.S. Census geocoder (on/off) and the inline timeout in ms.
GEOCODE=on
GEOCODE_INLINE_MS=3500
